{
  "name": "flowshopper-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/unit/",
    "coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines=70 node --test test/unit/",
    "test:e2e": "playwright test",
    "test:all": "npm run coverage && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "stripe": "^23.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "c8": "^12.0.0"
  }
}
